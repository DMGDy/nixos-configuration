{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "theme": "vs-dark",
  "ui_font": "Selawik",
  "font": "Cascadia Mono NF",
  "font_size": 14,
  "background": "canvas",
  "terminal_padding": [
    8,
    4
  ],
  "children": [
    {
      "id": "menubar",
      "type": "block",
      "size": {
        "px": 32
      },
      "window_drag": true,
      "content": {
        "mod": "vs-menubar"
      }
    },
    {
      "id": "toolbar",
      "type": "block",
      "size": {
        "px": 34
      },
      "content": {
        "mod": "vs-toolbar"
      }
    },
    {
      "id": "body",
      "type": "row",
      "padding": [
        4,
        4
      ],
      "gap": 4,
      "background": "canvas",
      "children": [
        {
          "id": "center",
          "type": "column",
          "gap": 4,
          "children": [
            {
              "id": "documents",
              "type": "column",
              "children": [
                {
                  "id": "doctabs",
                  "type": "block",
                  "size": {
                    "px": 26
                  },
                  "content": {
                    "mod": "vs-doctabs"
                  }
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 4,
                      "radius": 0,
                      "background": "background",
                      "lone": false,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      }
                    }
                  }
                }
              ]
            },
            {
              "id": "errors",
              "type": "block",
              "size": {
                "px": 230
              },
              "min": 110,
              "max": 640,
              "content": {
                "mod": "vs-errorlist"
              }
            }
          ]
        },
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 380
          },
          "min": 240,
          "max": 760,
          "children": [
            {
              "id": "dock",
              "type": "stack",
              "active": "solution",
              "children": [
                {
                  "id": "solution",
                  "type": "block",
                  "content": {
                    "mod": "vs-solution"
                  }
                },
                {
                  "id": "git-changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                },
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                }
              ]
            },
            {
              "id": "tooltabs",
              "type": "block",
              "size": {
                "px": 24
              },
              "content": {
                "mod": "vs-tooltabs"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 24
      },
      "content": {
        "mod": "vs-status"
      }
    }
  ]
}
