{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "theme": "imessage",
  "ui_font": "Inter",
  "background": "#ffffff",
  "terminal_padding": [
    18,
    14
  ],
  "children": [
    {
      "id": "ios-status",
      "type": "block",
      "size": {
        "px": 30
      },
      "window_drag": true,
      "content": {
        "mod": "imsg-status"
      }
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 380
          },
          "min": 280,
          "max": 560,
          "content": {
            "mod": "imsg-list"
          }
        },
        {
          "id": "convo",
          "type": "column",
          "resizable": false,
          "background": "#ffffff",
          "children": [
            {
              "id": "nav",
              "type": "block",
              "size": {
                "px": 82
              },
              "content": {
                "mod": "imsg-nav"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "padding": [
                12,
                18
              ],
              "children": [
                {
                  "id": "convo-stack",
                  "type": "stack",
                  "active": "output",
                  "children": [
                    {
                      "id": "output",
                      "type": "block",
                      "content": {
                        "mod": "imsg-output"
                      }
                    },
                    {
                      "id": "live",
                      "type": "column",
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 10,
                              "radius": 20,
                              "background": "background",
                              "lone": true,
                              "border": {
                                "width": 1,
                                "color": "#e9e9eb"
                              },
                              "focus": {
                                "width": 1,
                                "color": "#e9e9eb"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "thread",
              "type": "block",
              "size": {
                "px": 96
              },
              "content": {
                "mod": "imsg-thread"
              }
            },
            {
              "id": "compose",
              "type": "block",
              "size": {
                "px": 58
              },
              "content": {
                "mod": "imsg-compose"
              }
            }
          ]
        }
      ]
    }
  ]
}
