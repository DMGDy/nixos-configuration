{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "content": {
        "mod": "discord-titlebar"
      },
      "size": {
        "px": 24
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "rail",
          "type": "block",
          "content": {
            "mod": "discord-rail"
          },
          "size": {
            "px": 72
          },
          "resizable": false
        },
        {
          "id": "sidebar",
          "type": "block",
          "content": {
            "mod": "discord-channels"
          },
          "size": {
            "px": 240
          },
          "min": 200,
          "max": 400
        },
        {
          "id": "convo",
          "type": "column",
          "children": [
            {
              "id": "header",
              "type": "block",
              "content": {
                "mod": "discord-header"
              },
              "size": {
                "px": 48
              }
            },
            {
              "id": "chat-row",
              "type": "row",
              "children": [
                {
                  "id": "chat-col",
                  "type": "column",
                  "children": [
                    {
                      "id": "convo-stack",
                      "type": "stack",
                      "children": [
                        {
                          "id": "output",
                          "type": "block",
                          "content": {
                            "mod": "discord-chat"
                          }
                        },
                        {
                          "id": "forum",
                          "type": "block",
                          "content": {
                            "mod": "discord-forum"
                          }
                        },
                        {
                          "id": "live",
                          "type": "column",
                          "children": [
                            {
                              "id": "stream-bar",
                              "type": "block",
                              "size": {
                                "px": 48
                              },
                              "content": {
                                "mod": "discord-stream"
                              }
                            },
                            {
                              "id": "stream-body",
                              "type": "column",
                              "padding": [
                                8,
                                16
                              ],
                              "children": [
                                {
                                  "id": "main",
                                  "type": "block",
                                  "content": {
                                    "tab": "active",
                                    "pane": {
                                      "background": "#2b2d31",
                                      "border": {
                                        "width": 1,
                                        "color": "#1e1f22"
                                      },
                                      "focus": {
                                        "width": 1,
                                        "color": "#5865f2"
                                      },
                                      "radius": 8,
                                      "gap": 8,
                                      "lone": true
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "active": "output"
                    },
                    {
                      "id": "compose",
                      "type": "block",
                      "content": {
                        "mod": "discord-compose"
                      },
                      "size": {
                        "px": 68
                      }
                    }
                  ]
                },
                {
                  "id": "thread",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 560
                  },
                  "min": 360,
                  "max": 1000,
                  "children": [
                    {
                      "id": "thread-head",
                      "type": "block",
                      "size": {
                        "px": 48
                      },
                      "content": {
                        "mod": "discord-thread"
                      }
                    },
                    {
                      "id": "thread-term",
                      "type": "column",
                      "padding": [
                        8,
                        8
                      ],
                      "background": "#2b2d31",
                      "children": [
                        {
                          "id": "thread-agent",
                          "type": "block",
                          "content": {
                            "agent": "focused"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "members",
                  "type": "block",
                  "content": {
                    "mod": "discord-members"
                  },
                  "size": {
                    "px": 240
                  },
                  "min": 200,
                  "max": 400
                }
              ]
            }
          ],
          "background": "#313338"
        }
      ]
    }
  ],
  "background": "#1e1f22",
  "theme": "discord",
  "ui_font": "Noto Sans",
  "terminal_padding": [
    16,
    12
  ],
  "titlebar": "none"
}
