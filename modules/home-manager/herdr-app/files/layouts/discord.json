{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "content": {
        "mod": "discord-titlebar"
      },
      "size": {
        "px": 24
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "rail",
          "type": "block",
          "content": {
            "mod": "discord-rail"
          },
          "size": {
            "px": 72
          },
          "resizable": false
        },
        {
          "id": "sidebar",
          "type": "block",
          "content": {
            "mod": "discord-channels"
          },
          "size": {
            "px": 240
          },
          "min": 200,
          "max": 400
        },
        {
          "id": "convo",
          "type": "column",
          "children": [
            {
              "id": "header",
              "type": "block",
              "content": {
                "mod": "discord-header"
              },
              "size": {
                "px": 48
              }
            },
            {
              "id": "chat-row",
              "type": "row",
              "children": [
                {
                  "id": "chat-col",
                  "type": "column",
                  "children": [
                    {
                      "id": "convo-stack",
                      "type": "stack",
                      "children": [
                        {
                          "id": "output",
                          "type": "block",
                          "content": {
                            "mod": "discord-chat"
                          }
                        },
                        {
                          "id": "forum",
                          "type": "block",
                          "content": {
                            "mod": "discord-forum"
                          }
                        },
                        {
                          "id": "live",
                          "type": "column",
                          "children": [
                            {
                              "id": "stream-bar",
                              "type": "block",
                              "size": {
                                "px": 48
                              },
                              "content": {
                                "mod": "discord-stream"
                              }
                            },
                            {
                              "id": "stream-row",
                              "type": "row",
                              "children": [
                                {
                                  "id": "stream-body",
                                  "type": "column",
                                  "padding": [
                                    8,
                                    16
                                  ],
                                  "children": [
                                    {
                                      "id": "main",
                                      "type": "block",
                                      "content": {
                                        "tab": "active",
                                        "pane": {
                                          "background": "#00000059",
                                          "border": {
                                            "width": 1,
                                            "color": "#00000066"
                                          },
                                          "focus": {
                                            "width": 1,
                                            "color": "#5865f2"
                                          },
                                          "radius": 8,
                                          "gap": 8,
                                          "lone": true
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "id": "stream-chat",
                                  "type": "column",
                                  "hidden": true,
                                  "size": {
                                    "px": 380
                                  },
                                  "min": 300,
                                  "max": 720,
                                  "children": [
                                    {
                                      "id": "stream-output",
                                      "type": "block",
                                      "content": {
                                        "mod": "discord-chat",
                                        "props": {
                                          "side": true
                                        }
                                      }
                                    },
                                    {
                                      "id": "stream-compose",
                                      "type": "block",
                                      "content": {
                                        "mod": "discord-compose",
                                        "props": {
                                          "block": "stream-compose"
                                        }
                                      },
                                      "size": {
                                        "px": 68
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "active": "output"
                    },
                    {
                      "id": "compose",
                      "type": "block",
                      "content": {
                        "mod": "discord-compose"
                      },
                      "size": {
                        "px": 68
                      }
                    }
                  ]
                },
                {
                  "id": "thread",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 640
                  },
                  "min": 360,
                  "max": 1200,
                  "children": [
                    {
                      "id": "thread-head",
                      "type": "block",
                      "size": {
                        "px": 48
                      },
                      "content": {
                        "mod": "discord-thread"
                      }
                    },
                    {
                      "id": "thread-term",
                      "type": "column",
                      "padding": [
                        8,
                        8
                      ],
                      "background": "#00000038",
                      "children": [
                        {
                          "id": "thread-agent",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "background": "#00000059",
                              "border": {
                                "width": 1,
                                "color": "#00000066"
                              },
                              "focus": {
                                "width": 1,
                                "color": "#5865f2"
                              },
                              "radius": 8,
                              "gap": 8,
                              "lone": true
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "members",
                  "type": "block",
                  "content": {
                    "mod": "discord-members"
                  },
                  "size": {
                    "px": 240
                  },
                  "min": 200,
                  "max": 400
                }
              ]
            }
          ],
          "background": "#00000012"
        }
      ]
    }
  ],
  "background": {
    "image": "mods/discord-kit/backgrounds/dusk.png",
    "fit": "cover"
  },
  "theme": "discord",
  "ui_font": "Noto Sans",
  "terminal_padding": [
    16,
    12
  ],
  "titlebar": "none",
  "terminal_opacity": 0.6
}
